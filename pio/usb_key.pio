; FM-1 Transporter - JieLi USB_KEY and ROM calibration pulse generator.

.program usb_key_pp
.side_set 1
.wrap_target
    pull block          side 0
    set pins, 0         side 0
    set pindirs, 3      side 0
    set x, 14           side 0
bitloop:
    out pins, 1         side 0  [7]
    nop                 side 1  [10]
    jmp x-- bitloop     side 1
    out pins, 1         side 0  [7]
    nop                 side 1  [9]
    nop                 side 0          ; drive D+ low before releasing it (RP2350 E9)
    set pindirs, 0      side 0
.wrap

; The same with D- two pins above D+ (Raspberry Pi Debug Probe: GP4, GP6).
; The pin between stays an input.
.program usb_key_pp_gap
.side_set 1
.wrap_target
    pull block          side 0
    set pins, 0         side 0
    set pindirs, 5      side 0
    set x, 14           side 0
bitloop:
    out pins, 1         side 0  [7]
    nop                 side 1  [10]
    jmp x-- bitloop     side 1
    out pins, 1         side 0  [7]
    nop                 side 1  [9]
    nop                 side 0          ; drive D+ low before releasing it (RP2350 E9)
    set pindirs, 0      side 0
.wrap

.program sof_pulse
.wrap_target
    set pindirs, 1      [3]
    set pindirs, 0
    set x, 30
delay:
    nop                 [30]
    jmp x-- delay
    nop                 [1]
.wrap
